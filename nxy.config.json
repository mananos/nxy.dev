    "implementer": {
      "model": "sonnet",
      "provider": "claude"
    },
    "tester": {
      "model": "haiku",
      "provider": "claude"
    },
    "reviewer": {
      "model": "sonnet",
      "provider": "claude"
    },
    "documenter": {
      "model": "sonnet",
      "provider": "claude"
    },
    "librarian": {
