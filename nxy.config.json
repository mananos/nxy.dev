  "filter": {
    "engine": "auto",
    "excludeCommands": [],
    "onlyCommands": [],
    "autoAllowWhenOriginalAllowed": true
  },
  "metrics": {
    "projectsDir": null,
    "subscription": true,
    "statusline": {
      "color": true,
      "preset": "vivid",
