  "content": [
    "import { Component, Input, inject } from '@angular/core';",
    "import { ReactiveFormsModule, FormBuilder, Validators } from '@angular/forms';",
    "import { Factura } from '../facturas/factura.model';",
    "import { NotaCredito } from './nota-credito.model';",
    "import { NotaParcial } from './nota-parcial.model';",
    "import { NotaCreditoApi } from './nota-credito.api';",
    "",
    "// Pantalla para emitir una nota de crédito sobre una factura.",
    "// Muestra el saldo restante antes de confirmar.",
    "",
    "const MOTIVOS = [",
    "  'devolucion',",
    "  'error de facturacion',",
    "  'descuento posterior',",
    "  'diferencia de precio',",
    "  'pronto pago',",
    "];",
    "",
    "const MAX_DECIMALES = 2;",
    "",
    "function redondear(valor: number): number {",
    "  const f = Math.pow(10, MAX_DECIMALES);",
    "  return Math.round(valor * f) / f;",
    "}",
    "",
    "function esImporteValido(valor: number): boolean {",
    "  return Number.isFinite(valor) && valor > 0;",
    "}",
    "",
    "/**",
    " * Formulario de nota de crédito.",
    " * El importe parcial no puede superar el saldo de la factura.",
    " */",
    "// El selector lo usa factura-detalle.",
    "",
    "@Component({ selector: 'nota-credito' })",
    "export class NotaCreditoComponent {",
    "  @Input() factura!: Factura;",
    "  @Input() nota!: NotaParcial;",
    "  readonly saldo = this.nota.saldoRestante;",
    "",
    "  private readonly fb = inject(FormBuilder);",
    "  private readonly api = inject(NotaCreditoApi);",
    "",
    "  readonly motivos = MOTIVOS;",
    "",
    "  readonly form = this.fb.nonNullable.group({",
    "    importe: [0, [Validators.required, Validators.min(0.01)]],",
    "    motivo: ['devolucion', Validators.required],",
    "    comentario: [''],",
    "  });",
    "",
    "  get importe(): number {",
    "    return redondear(this.form.controls.importe.value);",
    "  }",
    "",
    "  get excedeSaldo(): boolean {",
    "    return this.importe > this.saldo;",
    "  }",
    "",
    "  get puedeEmitir(): boolean {",
    "    return this.form.valid && esImporteValido(this.importe) && !this.excedeSaldo;",
    "  }",
    "",
    "  get restante(): number {",
    "    return redondear(this.saldo - this.importe);",
    "  }",
    "",
    "  etiqueta(motivo: string): string {",
    "    return motivo.charAt(0).toUpperCase() + motivo.slice(1);",
    "  }",
    "",
    "  usarSaldoCompleto() {",
    "    this.form.controls.importe.setValue(this.saldo);",
    "  }",
    "",
    "  limpiar() {",
    "    this.form.reset({ importe: 0, motivo: 'devolucion', comentario: '' });",
    "  }",
    "",
    "  mostrarError(campo: 'importe' | 'motivo'): boolean {",
    "    const c = this.form.controls[campo];",
    "    return c.invalid && (c.dirty || c.touched);",
    "  }",
    "",
    "  mensajeImporte(): string {",
    "    if (this.form.controls.importe.hasError('min')) {",
    "      return 'El importe debe ser mayor a cero';",
    "    }",
    "    if (this.excedeSaldo) {",
    "      return 'El importe supera el saldo de la factura';",
    "    }",
    "    return '';",
    "  }",
    "",
    "  resumen(): string {",
    "    const motivo = this.etiqueta(this.form.controls.motivo.value);",
    "    return motivo + ': ' + this.importe + ' de ' + this.factura.numero;",
    "  }",
    "",
    "  confirmacion(): string {",
    "    return 'Vas a emitir ' + this.resumen() + '. Queda ' + this.restante + ' de saldo.';",
    "  }",
    "",
    "  private armarNota(): NotaParcial {",
    "    return {",
    "      facturaId: this.factura.id,",
    "      importe: this.importe,",
    "      motivo: this.form.controls.motivo.value,",
    "      comentario: this.form.controls.comentario.value,",
    "    } as NotaParcial;",
    "  }",
    "",
    "  private alFallar(error: unknown) {",
    "    console.error('No se pudo emitir la nota', error);",
    "  }",
    "",
    "  private alEmitir() {",
    "    this.limpiar();",
    "  }",
    "",
    "  cancelar() {",
    "    this.limpiar();",
    "  }",
    "",
    "  enfocarImporte() {",
    "    document.getElementById('importe')?.focus();",
    "  }",
    "",
    "  tieneComentario = () => this.form.controls.comentario.value.length > 0;",
    "",
    "  sinCambios(): boolean {",
    "    return this.form.pristine;",
    "  }",
    "",
    "  deshabilitado(): boolean {",
    "    return !this.puedeEmitir || this.sinCambios();",
    "  }",
    "  readonly titulo = 'Nota de crédito parcial';",
    "",
    "  emitir() {",
    "    this.api.emitirParcial(this.nota);",
    "  }",
    "}"
  ],
