[
  { "name": "empty", "allow": [], "deny": [] },
  { "name": "bash-all", "allow": ["Bash"], "deny": [] },
  { "name": "exact", "allow": ["Bash(git status)", "Bash(ls)"], "deny": [] },
  { "name": "prefix", "allow": ["Bash(git status:*)", "Bash(npm run:*)", "Bash(cd:*)"], "deny": [] },
  { "name": "wildcard", "allow": ["Bash(npm * test)", "Bash(git * --oneline)", "Bash(echo *)"], "deny": [] },
  { "name": "deny-only", "allow": [], "deny": ["Bash(rm:*)", "Bash(curl:*)"] },
  { "name": "mixed", "allow": ["Bash", "Read(./**)"], "deny": ["Bash(git push:*)", "Bash(rm -rf *)"] },
  { "name": "odd-forms", "allow": ["Bash()", "Bash(*)", "Bash(grep -rn \"a.b\" .)", "Edit"], "deny": ["Bash(sudo:*)"] }
]
