[
  { "name": "sed-inplace", "command": "sed -i 's/a/b/' f" },
  { "name": "sed-inplace-suffix-expr", "command": "sed -i.bak -e s/a/b/ f g" },
  { "name": "sed-no-inplace", "command": "sed s/a/b/ f" },
  { "name": "sed-long-inplace", "command": "sed --in-place=.bak s/a/b/ f" },
  { "name": "sed-cluster", "command": "sed -ni 's/a/b/p' f" },
  { "name": "perl-pi", "command": "perl -pi -e 's/a/b/' f" },
  { "name": "perl-Mstrict", "command": "perl -Mstrict -e 'print 1' f" },
  { "name": "perl-no-inplace", "command": "perl script.pl f" },
  { "name": "redirect", "command": "echo x > a.txt" },
  { "name": "redirect-non-ascii", "command": "echo x > cafà/à.txt" },
  { "name": "redirect-append", "command": "echo x >> a.txt" },
  { "name": "redirect-stderr", "command": "cmd 2> err.log" },
  { "name": "redirect-both", "command": "cmd &> all.log" },
  { "name": "redirect-clobber", "command": "echo x >| a.txt" },
  { "name": "redirect-input-only", "command": "sort < in.txt" },
  { "name": "tee", "command": "echo x | tee -a out.txt" },
  { "name": "cp", "command": "cp a b" },
  { "name": "cp-dir-slash", "command": "cp a b dir/" },
  { "name": "cp-single-dir-slash", "command": "cp a dir/" },
  { "name": "cp-t", "command": "cp -t dir a b" },
  { "name": "mv", "command": "mv a b" },
  { "name": "mv-dir-slash", "command": "mv a b out/" },
  { "name": "cp-unresolvable-source", "command": "cp *.txt dir/" },
  { "name": "truncate", "command": "truncate -s 0 f" },
  { "name": "dd", "command": "dd if=a of=b" },
  { "name": "quoted-target", "command": "echo x > \"my file.txt\"" },
  { "name": "cd-chain", "command": "cd sub && echo x > f" },
  { "name": "cd-dotdot", "command": "cd sub && cd .. && echo x > f" },
  { "name": "cd-home", "command": "cd ~ && echo x > rel" },
  { "name": "cd-dash", "command": "cd - && echo x > rel" },
  { "name": "cd-var", "command": "cd $DIR && echo x > rel" },
  { "name": "prefixes", "command": "FOO=1 sudo rtk sed -i s/a/b/ f" },
  { "name": "env-prefix", "command": "env X=1 tee out.txt" },
  { "name": "exe-suffix", "command": "sed.exe -i s/a/b/ f" },
  { "name": "tilde-inside-word", "command": "sed -i s/a/b/ RUNNER~1/f" },
  { "name": "tilde-inside-cd", "command": "cd RUNNER~1 && echo x > f" },
  { "name": "tilde-start", "command": "echo x > ~/out.txt" },
  { "name": "dup-stderr", "command": "cmd 2>&1" },
  { "name": "dev-null", "command": "cmd >/dev/null 2>&1" },
  { "name": "nul", "command": "cmd > NUL" },
  { "name": "nul-lower", "command": "cmd > nul" },
  { "name": "quoted-gt", "command": "echo \"a > b\"" },
  { "name": "heredoc-body", "command": "cat <<EOF\nfoo > x\nEOF" },
  { "name": "heredoc-with-redirect", "command": "cat > out.txt <<EOF\nfoo > x\nEOF" },
  { "name": "heredoc-quoted-word", "command": "cat > out.txt <<'EOF'\nfoo > x\nEOF\necho y > after.txt" },
  { "name": "heredoc-dash", "command": "cat >> out.txt <<-EOF\n\tfoo > x\n\tEOF" },
  { "name": "herestring", "command": "cat <<< x > out.txt" },
  { "name": "variable-target", "command": "echo x > \"$OUT\"" },
  { "name": "glob-target", "command": "ls *.txt" },
  { "name": "brace-target", "command": "echo x > f{1,2}" },
  { "name": "quoted-multiline-double", "command": "echo \"line one\na > x\" " },
  { "name": "quoted-multiline-single", "command": "echo 'line one\na > x'" },
  { "name": "two-lines", "command": "echo a\necho b > f" },
  { "name": "dedupe", "command": "echo a > f && echo b >> f" },
  { "name": "order", "command": "echo a > z && echo b > a && echo c > m" },
  { "name": "absolute-target", "command": "echo x > /abs/out.txt" },
  { "name": "empty", "command": "" },
  { "name": "ps-set-content", "tool": "PowerShell", "command": "Set-Content -Path out.txt -Value x" },
  { "name": "ps-set-content-positional", "tool": "PowerShell", "command": "Set-Content out.txt x" },
  { "name": "ps-out-file", "tool": "PowerShell", "command": "'x' | Out-File o.txt" },
  { "name": "ps-add-content-literal", "tool": "PowerShell", "command": "Add-Content -LiteralPath a.txt -Value x" },
  { "name": "ps-redirect", "tool": "PowerShell", "command": "echo x > a.txt" },
  { "name": "ps-sed-ignored", "tool": "PowerShell", "command": "sed -i s/a/b/ f" },
  { "name": "ps-set-location", "tool": "PowerShell", "command": "Set-Location sub; Set-Content f x" }
]
