  },
  "detect": [
    {"settings": [], "mcp": [], "obj": null},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": "rtk hook claude"}]}]}}], "mcp": [], "obj": {}},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": "C:\\bin\\rtk.exe hook claude"}]}]}}], "mcp": [], "obj": {"mcpServers": {}}},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": "myrtk hook"}]}]}}], "mcp": [], "obj": {"mcpServers": {"codegraph": {"command": "codegraph"}}}},
    {"settings": [{"hooks": {"PostToolUse": [{"hooks": [{"command": "rtk hook claude"}]}]}}], "mcp": [], "obj": {"mcpServers": {"other": {}}}},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": 42}, {"command": null}, {}]}, {}, null]}}], "mcp": [], "obj": {"mcpServers": {"codegraph": null}}},
    {"settings": [{"hooks": {"PreToolUse": "rtk hook"}}], "mcp": [], "obj": {"mcpServers": ["codegraph"]}},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": "rtk\nhook"}]}]}}], "mcp": [], "obj": {"mcpServers": "codegraph"}},
    {"settings": [null, 3, "x", []], "mcp": [null, []], "obj": []},
    {"settings": [{"hooks": {"SessionStart": [{"hooks": [{"command": "node CodeGraph/sync.js"}]}]}}], "mcp": [], "obj": null},
    {"settings": [{"hooks": {"PostToolUse": [{"hooks": [{"command": "codegraph sync"}, {"command": "other"}]}]}}], "mcp": [{}], "obj": null},
    {"settings": [{"hooks": [{"command": "codegraph"}]}], "mcp": [], "obj": null},
    {"settings": [{"hooks": {"Stop": [{"hooks": "codegraph"}]}}], "mcp": [], "obj": null},
    {"settings": [{"theme": "dark"}], "mcp": [{"mcpServers": {"codegraph": {}}}], "obj": null},
    {"settings": [{"mcpServers": {"codegraph": {}}}], "mcp": [], "obj": null},
    {"settings": [{"hooks": {"PreToolUse": [{"hooks": [{"command": "rtk hook"}]}], "Stop": [{"hooks": [{"command": "codegraph x"}]}]}}], "mcp": [{"projects": {}}], "obj": null}
  ],
  "sudo": [
    "",
