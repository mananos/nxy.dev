    ["codegraph", {"platform": "win32", "found": true, "conflict": "mcp", "mcpScope": "user"}, [{"stdout": "removed"}, {"stdout": "done"}]],
    ["codegraph", {"platform": "linux", "found": true, "conflict": "mcp", "mcpScope": "user"}, [{"stdout": "removed"}, {"stderr": "boom", "status": 1}]],
    ["rtk", {"platform": "linux"}, [{"stdoutRepeat": ["x", 1600]}]],
    ["rtk", {"platform": "linux"}, [{"stdoutRepeat": ["\ud83d\ude00", 800]}]],
    ["rg", {"platform": "linux", "pm": "apt-get"}, [{"stdoutRepeat": ["y", 1600], "stderr": "sudo: a password is required", "status": 1}]]
