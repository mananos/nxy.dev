  "run": [
    ["rtk", {"platform": "linux"}, [{"stdout": "installed\n"}]],
    ["rtk", {"platform": "win32"}, [{"stdout": "  \n ok \n\n", "stderr": "warn\n"}]],
    ["rg", {"platform": "linux", "pm": "apt-get"}, [{"stderr": "sudo: a password is required\n", "status": 1}]],
    ["rg", {"platform": "linux", "pm": "dnf"}, [{"stderr": "sudo: se requiere una contraseña", "status": 1}]],
    ["rg", {"platform": "linux", "pm": "pacman"}, [{"stderr": "error: could not lock database", "status": 1}]],
