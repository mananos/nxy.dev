{
  "description": "nxy: every hook event goes through the Go binary via the polyglot shim (bin/nxy.cmd): the /nxy:feature and /nxy:engineer flow, the Bash filter, the write and read gate, memory, review and the one-time import of 1.x data",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 1800,
            "statusMessage": "nxy: si tenés la TUI abierta, contestá ahí"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"${CLAUDE_PLUGIN_ROOT}/bin/nxy.cmd\"; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
